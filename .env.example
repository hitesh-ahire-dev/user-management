# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ---------------------------------------------------------------------------

# ---- Local development (docker-compose MySQL + mvn spring-boot:run) -------
SPRING_PROFILES_ACTIVE=local

# MySQL container credentials (used by docker-compose MySQL service only)
MYSQL_DATABASE=user_management
MYSQL_USER=appuser
MYSQL_PASSWORD=change_me_password
MYSQL_ROOT_PASSWORD=change_me_root

# Override only if your local MySQL differs from the defaults in application-local.yml
# DB_URL=jdbc:mysql://localhost:3306/user_management?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
# DB_USERNAME=appuser
# DB_PASSWORD=change_me_password

# ---- Render.com deployment ------------------------------------------------
# Set these as Secret environment variables in the Render dashboard.
# Do NOT put real values here.
#
# DB_URL=jdbc:mysql://<host>:<port>/user_management?sslMode=VERIFY_IDENTITY&...
# DB_USERNAME=<your_external_mysql_user>
# DB_PASSWORD=<your_external_mysql_password>
